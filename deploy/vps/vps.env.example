# Copy to deploy/vps/.env on the VPS and fill in. chmod 600 deploy/vps/.env
# Do NOT quote values and do NOT commit the real file.

# Required while nobody has registered yet: whoever registers first owns the instance.
# Generate:  openssl rand -hex 16
CLOUDCLI_SETUP_TOKEN=

# Number of reverse proxies in FRONT of the container that append X-Forwarded-For.
#   nginx / Caddy / cloudflared on the VPS (no Cloudflare orange-cloud proxy): 1
#   Cloudflare proxied DNS record in front of nginx:                            2
# Wrong (too low) = every client shows the proxy IP and one attacker's failed logins lock you out.
TRUST_PROXY=1

# Master key that seals the pairing secrets stored in the database (base64 of 32 random bytes).
# Generate:  openssl rand -base64 32
# Keep a copy in your password manager. Lose it = re-pair every device.
# Keep it OUT of backups of the data volume (a backup holding both = every pairing exposed).
CLOUDCLI_REMOTE_MASTER_KEY=

# --- optional -------------------------------------------------------------
# Kill switch: 1 = mount nothing of Remote (the app behaves as before Remote existed).
# CLOUDCLI_REMOTE_DISABLED=1
# Drop the anti-framing / Referrer-Policy headers on the main page (Remote stays on).
# CLOUDCLI_REMOTE_MAIN_PAGE_HEADERS=0
# Leave JWT_SECRET unset unless you must pin it (a pinned secret cannot be rotated by "log out everywhere").
# JWT_SECRET=
