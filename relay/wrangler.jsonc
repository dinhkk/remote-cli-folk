{
  // Worker name and any custom domain are chosen by the user at deploy time (phase 13);
  // this placeholder must never be deployed as-is.
  "name": "cloudcli-remote-relay-dev",
  "main": "src/index.ts",
  // The relay has no routes of its own: it is reached on <worker>.<subdomain>.workers.dev (phase 13 picks the names).
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // The relay does not log; keep Workers Logs off so nothing about connections is persisted.
  "observability": { "enabled": false },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
