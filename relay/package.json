{
  "name": "cloudcli-remote-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker + Durable Object relay for CloudCLI Remote Work (opaque E2E-encrypted frame forwarder).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project workers --project node",
    "test:wrangler": "vitest run --project wrangler",
    "test:all": "vitest run",
    "sync-vectors": "node scripts/sync-vectors.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.157.0",
    "ws": "^8.22.1"
  }
}
